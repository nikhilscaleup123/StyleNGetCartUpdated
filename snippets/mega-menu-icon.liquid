{% comment %}
  Usage:
  {% render 'mega-menu-icon', handle: link.handle, title: link.title %}
{% endcomment %}

{%- liquid
  assign icon_key = handle | default: '' | downcase
  assign icon_title = title | default: '' | downcase
  assign icon_type = 'default'

  if icon_key contains 'mug' or icon_title contains 'mug' or icon_title contains 'coffee'
    assign icon_type = 'mug'
  elsif icon_key contains 'sipper' or icon_key contains 'bottle' or icon_title contains 'sipper' or icon_title contains 'bottle' or icon_title contains 'drink'
    assign icon_type = 'bottle'
  elsif icon_key contains 'cap' or icon_key contains 'hat' or icon_title contains 'cap' or icon_title contains 'hat'
    assign icon_type = 'cap'
  elsif icon_key contains 'cloth' or icon_key contains 'tshirt' or icon_key contains 't-shirt' or icon_title contains 'clothing' or icon_title contains 't-shirt' or icon_title contains 'shirt'
    assign icon_type = 'clothing'
  elsif icon_key contains 'puzzle' or icon_key contains 'game' or icon_title contains 'puzzle' or icon_title contains 'game'
    assign icon_type = 'puzzle'
  elsif icon_key contains 'gift' or icon_key contains 'personal' or icon_title contains 'gift' or icon_title contains 'personal'
    assign icon_type = 'gift'
  elsif icon_key contains 'accessori' or icon_title contains 'accessori'
    assign icon_type = 'accessories'
  endif
-%}

{%- case icon_type -%}
  {%- when 'mug' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5 7h11v8a4 4 0 0 1-4 4H9a4 4 0 0 1-4-4V7z"/>
      <path d="M16 9h2.5a2.5 2.5 0 0 1 0 5H16"/>
      <path d="M8 3v2M12 3v2"/>
    </svg>
  {%- when 'bottle' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M9 2h6"/>
      <path d="M10 2v3.2c0 .6-.2 1.1-.6 1.5L8 9v10a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2V9l-1.4-2.3c-.4-.4-.6-.9-.6-1.5V2"/>
      <path d="M8 13h8"/>
    </svg>
  {%- when 'cap' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 14c1.5-4.5 5-7 8-7s6.5 2.5 8 7"/>
      <path d="M2 15h20"/>
      <path d="M6 15v2a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-2"/>
    </svg>
  {%- when 'clothing' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M8 4l-4 3 2 3 2-1v11h8V9l2 1 2-3-4-3-2 2h-2L8 4z"/>
    </svg>
  {%- when 'puzzle' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M10 4h4v3a2 2 0 1 0 2 2h4v4h-3a2 2 0 1 0-2 2v4h-4v-3a2 2 0 1 0-2-2H4v-4h3a2 2 0 1 0 2-2V4z"/>
    </svg>
  {%- when 'gift' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="10" width="18" height="11" rx="1"/>
      <path d="M12 10V21"/>
      <path d="M3 14h18"/>
      <path d="M12 10c-2.5-4-6-4-6-2s2 3 6 2z"/>
      <path d="M12 10c2.5-4 6-4 6-2s-2 3-6 2z"/>
    </svg>
  {%- when 'accessories' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="3"/>
      <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
    </svg>
  {%- else -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="4" y="4" width="16" height="16" rx="2"/>
      <path d="M8 9h8M8 12h8M8 15h5"/>
    </svg>
{%- endcase -%}
