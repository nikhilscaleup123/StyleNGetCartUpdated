{%- comment -%}
  Renders a line-art icon for announcement bar blocks.
  Icons are assigned by block order: truck, percent, gift.
{%- endcomment -%}

{%- case block_index -%}
  {%- when 2 -%}
    <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="9"/>
      <line x1="9" y1="9" x2="15" y2="15"/>
      <circle cx="9" cy="9" r="1.5" fill="currentColor" stroke="none"/>
      <circle cx="15" cy="15" r="1.5" fill="currentColor" stroke="none"/>
    </svg>
  {%- when 3 -%}
    <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="8" width="18" height="12" rx="1"/>
      <path d="M12 8v12"/>
      <path d="M3 12h18"/>
      <path d="M12 8c-2.5-3.5-5.5-3-5 0 .4 2 2.2 2.5 5 0"/>
      <path d="M12 8c2.5-3.5 5.5-3 5 0-.4 2-2.2 2.5-5 0"/>
    </svg>
  {%- else -%}
    {%- comment -%} Clean outline delivery truck {%- endcomment -%}
    <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M1 4h13v11H1z"/>
      <path d="M14 8h4l3 3v4h-7V8z"/>
      <path d="M14 11h7"/>
      <circle cx="5.5" cy="18.5" r="2"/>
      <circle cx="17.5" cy="18.5" r="2"/>
      <path d="M7.5 18.5h8"/>
    </svg>
  {%- endcase -%}
